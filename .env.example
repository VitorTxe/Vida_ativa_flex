# Chave da API do Google Gemini (Recomendado - Gratuito e Rápido)
# Obtenha gratuitamente em: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=sua_chave_gemini_aqui

# Modelo do Gemini (padrão: gemini-1.5-flash ou gemini-2.0-flash)
GEMINI_MODEL=gemini-1.5-flash

# (Opcional) Chave da OpenAI - mantida como alternativa secundária
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Integração Strava (mantenha Client Secret e chave de criptografia somente no servidor)
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_REDIRECT_URI=http://localhost:3000/api/strava/callback
# Use uma sequência aleatória longa (mínimo recomendado: 32 caracteres)
STRAVA_TOKEN_ENCRYPTION_KEY=

# Webhook opcional para revogação, exclusão e privacidade de atividades
STRAVA_WEBHOOK_VERIFY_TOKEN=
# Preencha depois de criar a assinatura do webhook no Strava
STRAVA_WEBHOOK_SUBSCRIPTION_ID=
